# SmartLearn AI Environment Variables
#
# ---- OPTION A (Recommended, FREE): Groq ----
# 1. Go to https://console.groq.com  -> sign up (no credit card needed)
# 2. Create an API key (starts with "gsk_")
# 3. Paste it below
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- OPTION B (Paid): OpenAI ----
# Only needed if you'd rather use OpenAI instead of Groq.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Force a specific provider if BOTH keys above are filled in.
# Leave blank to auto-prefer Groq. Values: "groq" or "openai"
AI_PROVIDER=

FLASK_SECRET_KEY=smartlearn_ai_secret_key_hackathon_2026
